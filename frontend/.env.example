DATABASE_URL=postgresql://roboticgen:roboticgen@127.0.0.1:5432/roboticgen

# MongoDB, for project/submission Markdown bodies -- see database/README.md
MONGODB_URI=mongodb://roboticgen:roboticgen@127.0.0.1:27017
MONGODB_DB=roboticgen

# Private S3 bucket for uploaded images -- served only through
# app/api/media/[id]/route.ts, which enforces ownership checks. Don't make
# the bucket public. The IAM user/role needs s3:PutObject, s3:GetObject and
# s3:DeleteObject on arn:aws:s3:::<bucket>/*.
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: an S3-compatible server instead of AWS, e.g. local MinIO at
# http://127.0.0.1:9000. Leave empty for AWS.
S3_ENDPOINT=

# Google OAuth client, from Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI: <origin>/api/auth/callback/google
CLIENT_ID=
CLIENT_SECRET=
# Same client ID, exposed to the browser for Google One Tap. Not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=$CLIENT_ID

SITE_URL=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Weekly email digest. Any SMTP provider works; port 465 uses TLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Obo Space <projects@roboticgen.co>"
# The digest is sent by a pg-boss job in the app server (src/core/jobs.ts).
# Cron expression and timezone for it; defaults are Monday 08:00 UTC.
DIGEST_CRON="0 8 * * 1"
DIGEST_TZ=UTC
# Protects POST /api/cron/digest, a manual trigger for the same digest. Generate like AUTH_SECRET.
CRON_SECRET=

# Always granted the admin role on sign-in; can't be demoted, disabled or
# deleted from the admin page.
ADMIN_EMAIL=isurumuni@roboticgen.co
