// Prisma model of the schema defined in database/init/*.sql.
// This file is schema-only: no client has been generated and no
// migration has been run from it. It exists so a future Prisma-backed
// service has a starting model that matches the hand-written SQL
// exactly, table for table, column for column.
//
// A few things in database/init/*.sql cannot be expressed in Prisma's
// schema language and are called out inline below with NOT REPRESENTED.
// Whoever wires this up for real should generate the first migration
// with `prisma migrate dev --create-only` against a database already
// running database/init/*.sql, then hand-edit that migration to restore
// the NOT REPRESENTED pieces, rather than trusting `prisma db push` /
// a fresh `prisma migrate dev` to reproduce them.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum UserRole {
  student
  mentor
  admin

  @@map("user_role")
}

enum ProjectStatus {
  draft
  pending_review
  published
  rejected

  @@map("project_status")
}

enum MediaOwnerType {
  project
  submission

  @@map("media_owner_type")
}

// Fixed, admin-defined taxonomy -- a closed set changed only via
// migration, not an admin-editable table.
enum ProjectCategory {
  robotics
  electronics
  iot
  coding_software
  ai_ml
  drones
  threed_printing
  sensors_automation
  competitions
  other

  @@map("project_category")
}

// ---------------------------------------------------------------------
// users
// ---------------------------------------------------------------------

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleId     String   @unique @map("google_id")
  email        String   @unique @db.Citext
  displayName  String   @map("display_name")
  /// Picture URL from the Google OAuth profile (`picture` claim). No
  /// local generation/storage; refreshed from Google on login.
  avatarUrl    String?  @map("avatar_url")
  role         UserRole @default(student)
  bio          String?
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  projects          Project[]      @relation("ProjectAuthor")
  reviewedProjects  Project[]      @relation("ProjectReviewedBy")
  likes             ProjectLike[]
  stars             ProjectStar[]
  submissions       Submission[]

  // Back-relations required by the view fields below (a view relation
  // needs an opposite field on both sides -- see the Views section for
  // why these can't be inferred from a real FK). Each is the same
  // underlying user_id/author_id column the view already selects.
  dashboardStats         UserDashboardStats[]
  pendingReviewsAsAuthor PendingReviewQueue[]
  likedProjectsFeed      UserLikedProjects[]
  starredProjectsFeed    UserStarredProjects[]

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------
// projects
// ---------------------------------------------------------------------

model Project {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId        String          @map("author_id") @db.Uuid
  category        ProjectCategory
  title           String
  slug            String        @unique
  summary         String
  /// MongoDB _id of the markdown document. No FK -- Mongo is a separate store.
  contentDocId    String        @map("content_doc_id")
  status          ProjectStatus @default(draft)
  isFeatured      Boolean       @default(false) @map("is_featured")
  reviewedById    String?       @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at") @db.Timestamptz
  rejectionReason String?       @map("rejection_reason")
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz
  viewCount       BigInt        @default(0) @map("view_count")
  /// Denormalized, kept in sync by DB triggers on project_likes -- do not write from app code.
  likeCount       BigInt        @default(0) @map("like_count")
  /// Denormalized, kept in sync by DB triggers on project_stars -- do not write from app code.
  starCount       BigInt        @default(0) @map("star_count")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  author     User          @relation("ProjectAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedBy User?         @relation("ProjectReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  likes      ProjectLike[]
  stars      ProjectStar[]
  submissions Submission[]

  // Back-relations required by the view fields below -- see the Views section.
  pendingReviewEntry PendingReviewQueue[]
  likedFeedEntries   UserLikedProjects[]
  starredFeedEntries UserStarredProjects[]

  // NOT REPRESENTED (kept only in database/init/004_tables.sql):
  //   - search_vector TSVECTOR GENERATED ALWAYS AS (...) STORED
  //     Prisma has no tsvector / generated-column support; it must be
  //     added back by hand in the migration SQL, together with its
  //     GIN index (idx_projects_search_vector) and the pg_trgm GIN
  //     index on title (idx_projects_title_trgm).
  //   - Partial indexes: idx_projects_published_feed,
  //     idx_projects_category_published, idx_projects_featured,
  //     idx_projects_pending_review. Prisma's schema language does not
  //     support index WHERE predicates -- these must also be restored
  //     by hand in the migration SQL, or query performance on the
  //     browse/search/review-queue paths regresses to full scans.
  //   - CHECK constraints chk_projects_review_fields and
  //     chk_projects_published_at.

  @@index([authorId, status])
  @@map("projects")
}

// ---------------------------------------------------------------------
// media_assets
// ---------------------------------------------------------------------

model MediaAsset {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType MediaOwnerType @map("owner_type")
  /// Points at either a Project.id or a Submission.id depending on
  /// ownerType. No single Prisma/Postgres FOREIGN KEY can target two
  /// different tables from one column, so this is enforced at the DB
  /// level by triggers instead (validate_media_asset_owner,
  /// cascade_delete_media_assets in database/init/003_functions.sql) --
  /// existence-checked on write, cascade-deleted with the owner, same
  /// net effect as a real FK. Prisma has no way to represent a
  /// trigger-enforced relation, so there is no `@relation` field here;
  /// resolve ownerId to a Project or Submission in application code
  /// based on ownerType.
  ownerId   String         @map("owner_id") @db.Uuid
  filePath  String         @map("file_path")
  altText   String?        @map("alt_text")
  position  Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([ownerType, ownerId, position])
  @@map("media_assets")
}

// ---------------------------------------------------------------------
// project_likes
// ---------------------------------------------------------------------

model ProjectLike {
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
  @@map("project_likes")
}

// ---------------------------------------------------------------------
// project_stars
// ---------------------------------------------------------------------

model ProjectStar {
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
  @@map("project_stars")
}

// ---------------------------------------------------------------------
// submissions
// ---------------------------------------------------------------------

model Submission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  /// MongoDB _id of the markdown document.
  contentDocId String   @map("content_doc_id")
  /// true = only userId may read this submission. No other role is
  /// granted access anywhere in this schema.
  isPrivate    Boolean  @default(true) @map("is_private")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("submissions")
}

// ---------------------------------------------------------------------
// Views (database/init/005_views.sql)
//
// `previewFeatures = ["views"]` above is what lets these `view` blocks
// exist at all; they were generated by introspecting the live container
// (`prisma db pull`) and hand-annotated to add the relations below.
//
// A view carries no foreign key in Postgres -- a FK is a constraint on a
// stored table, and a view has no storage of its own (it's a saved
// SELECT, re-run on every query; see database/README.md). So introspection
// alone can *never* produce a relation field on a view: it found 4 view
// definitions here and added zero relation fields, only plain scalar
// columns, every one of them nullable (Postgres reports view output as
// nullable regardless of the source columns' own nullability).
//
// The `user`/`project`/`author` fields below are added by hand, not by
// introspection: they tell Prisma Client "this view's user_id column
// lines up with User.id" so `.include`/`.select` can traverse it like
// any other relation. That's a client-side convenience only -- there is
// still no constraint enforcing it in Postgres, so if a view's SELECT
// ever changes to source user_id from somewhere else, these relations
// have to be updated by hand; nothing will fail loudly if they drift.
// ---------------------------------------------------------------------

view UserDashboardStats {
  userId              String?  @map("user_id") @db.Uuid
  draftProjects       BigInt?  @map("draft_projects")
  pendingProjects     BigInt?  @map("pending_projects")
  publishedProjects   BigInt?  @map("published_projects")
  rejectedProjects    BigInt?  @map("rejected_projects")
  totalLikesReceived  Decimal? @map("total_likes_received") @db.Decimal
  totalStarsReceived  Decimal? @map("total_stars_received") @db.Decimal
  submissionsCount    BigInt?  @map("submissions_count")

  user User? @relation(fields: [userId], references: [id])

  @@map("user_dashboard_stats")
}

view PendingReviewQueue {
  id         String?           @db.Uuid
  title      String?
  slug       String?
  authorId   String?           @map("author_id") @db.Uuid
  authorName String?           @map("author_name")
  category   ProjectCategory?
  createdAt  DateTime?         @map("created_at") @db.Timestamptz

  /// Same row as the underlying Project (id is projects.id, unfiltered by this view's WHERE).
  project Project? @relation(fields: [id], references: [id])
  author  User?    @relation(fields: [authorId], references: [id])

  @@map("pending_review_queue")
}

view UserLikedProjects {
  userId    String?           @map("user_id") @db.Uuid
  likedAt   DateTime?         @map("liked_at") @db.Timestamptz
  projectId String?           @map("project_id") @db.Uuid
  title     String?
  slug      String?
  category  ProjectCategory?
  authorId  String?           @map("author_id") @db.Uuid
  likeCount BigInt?           @map("like_count")
  starCount BigInt?           @map("star_count")

  user    User?    @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@map("user_liked_projects")
}

view UserStarredProjects {
  userId     String?           @map("user_id") @db.Uuid
  startedAt  DateTime?         @map("started_at") @db.Timestamptz
  projectId  String?           @map("project_id") @db.Uuid
  title      String?
  slug       String?
  category   ProjectCategory?
  authorId   String?           @map("author_id") @db.Uuid
  likeCount  BigInt?           @map("like_count")
  starCount  BigInt?           @map("star_count")

  user    User?    @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@map("user_starred_projects")
}
